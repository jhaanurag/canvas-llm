# ── Convex ──
# Your Convex deployment URL (from `npx convex dev` or the Convex dashboard)
NEXT_PUBLIC_CONVEX_URL=

# ── Clerk ──
# Get these from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# The Clerk JWT issuer domain — required for Convex auth integration.
# Typically: https://<your-clerk-frontend-api>.clerk.accounts.dev
CLERK_JWT_ISSUER_DOMAIN=

# ── LLM Proxy ──
# Local LiteLLM proxy (run via start.sh)
LLM_LOCAL_PROXY_URL=http://127.0.0.1:4000
# Remote fallback proxy
LLM_REMOTE_PROXY_URL=
# Shared API key for proxy auth
LLM_PROXY_KEY=
