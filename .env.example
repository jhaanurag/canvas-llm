# ── Convex ──
# Your Convex deployment URL (from `npx convex dev` or the Convex dashboard)
NEXT_PUBLIC_CONVEX_URL=

# ── App Auth ──
# Used to sign and verify the lightweight JWT session for canvas save sync.
AUTH_JWT_SECRET=
# Optional custom issuer string for your JWTs.
AUTH_JWT_ISSUER=canvas-atlas

# ── LLM (GitHub Copilot, direct) ──
# Long-lived GitHub OAuth access token (device-code flow, never expires).
# The API route exchanges it for a short-lived Copilot session token on
# every request, so no LiteLLM process or persistent disk is needed.
GITHUB_COPILOT_ACCESS_TOKEN=
